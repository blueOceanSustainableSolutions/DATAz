# All values are OPTIONAL — the app ships with working public defaults baked into
# src/config.js. Override any of these at build time only if you need to point at
# a different deployment or API key.

# Production backend API base (must include the /api suffix).
VITE_API_BASE_URL=https://hydrotwin-prod-backend.agreeableriver-a8000f03.northeurope.azurecontainerapps.io/api

# Force a specific site id. Leave unset to use the only site the account can access.
# VITE_SITE_ID=2

# Header / browser-tab title.
VITE_PAGE_TITLE=DATAz

# Read-only backend API key sent as X-API-Key.
VITE_API_KEY=

VITE_ENABLE_NUMERICAL_VIZ=true
