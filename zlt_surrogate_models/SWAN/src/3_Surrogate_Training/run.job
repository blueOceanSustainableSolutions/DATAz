#!/bin/bash

#SBATCH --partition=dev-a100-40
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --job-name=swan-ml
#SBATCH --time=04:00:00
#SBATCH --account=f202500265dt4stf2g
#SBATCH --chdir=/projects/F202500265DT4STF2/HPC_SWAN_Surrogate_Github/src/3_Surrogate_Training
#SBATCH --output=logs/%j.out
#SBATCH --error=logs/%j.err

set -euo pipefail

echo "Starting GPU job on $(hostname)"

WORKDIR="/projects/F202500265DT4STF2/HPC_SWAN_Surrogate_Github/src/3_Surrogate_Training"
PROJECT_ROOT="/projects/F202500265DT4STF2/HPC_SWAN_Surrogate_Github"

# Sequence dataset to train from. Must exist from Stage 2.
SEQUENCES_ROOT="$PROJECT_ROOT/data/general_preprocessing/test/sequences"
SEQUENCE_NAME="500"
BATCH_SIZE=32
NUM_WORKERS=0

# =========================
# 1. Load only minimal modules
# =========================
module purge

# =========================
# 2. Activate conda safely
# =========================
source /projects/F202500265DT4STF2/miniconda3/etc/profile.d/conda.sh

set +u
conda activate swan_surrogate_env
set -u

# =========================
# 3. Prevent CPU thread explosion (fix OpenBLAS crash)
# =========================
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# =========================
# 4. GPU sanity check
# =========================
nvidia-smi

python -c "import torch; print(torch.cuda.is_available())"

# =========================
# 5. Run training
# =========================
cd "$WORKDIR"
export PYTHONPATH="$WORKDIR:$PROJECT_ROOT/src/2_Surrogate_Preprocessing:$PROJECT_ROOT/src:$PROJECT_ROOT:${PYTHONPATH:-}"

python -u 2_TRAIN.py \
	--sequences-root "$SEQUENCES_ROOT" \
	--sequence-name "$SEQUENCE_NAME" \
	--batch-size "$BATCH_SIZE" \
	--num-workers "$NUM_WORKERS"

echo "Finished GPU job ID $SLURM_JOB_ID on $(hostname)"
echo "Total Time: $(sacct -j $SLURM_JOB_ID --format=Elapsed -n | tail -n 1)"