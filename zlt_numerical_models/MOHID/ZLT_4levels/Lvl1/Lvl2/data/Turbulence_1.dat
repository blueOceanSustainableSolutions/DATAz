CONTINUOUS              : 0 ! 0 = spin-up run, 1 = continue from previous solution

OUTPUT_TIME             : 0.0 43200.0
TIME_SERIE              : 1
TIME_SERIE_LOCATION     : ../../../GeneralData/TimeSeries/TimeSerieLocation.dat

! Horizontal sub-grid-scale turbulent viscosity
MODVISH                 : smagorinsky
VISH_REF                : 400.0 ! dx/10
HORCON                  : 0.2

! Vertical sub-grid-scale turbulent viscosity
MODTURB                 : turbulence_equation

